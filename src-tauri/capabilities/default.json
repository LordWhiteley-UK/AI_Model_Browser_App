{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the AI Model Browser",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:8000" },
        { "url": "http://127.0.0.1:8000" },
        { "url": "http://localhost:*" },
        { "url": "http://127.0.0.1:*" },
        { "url": "https://huggingface.co" },
        { "url": "https://*.huggingface.co" },
        { "url": "https://cdn.jsdelivr.net" }
      ]
    }
  ]
}
